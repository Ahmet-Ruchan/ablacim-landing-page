---
import { t, localePath, type Locale } from '../i18n';
import { siteConfig, withBase } from '../site.config';
import instagramIcon from '../../assets/icons/instagram.svg?raw';
import tiktokIcon from '../../assets/icons/tiktok.svg?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const d = dict.footer;

// Dil eşleşmesi (BRIEF-EK S-6): TR sayfada ablacimofficial,
// EN sayfada ablaciminternational; TikTok her ikisinde de görünür.
const instagramUrl =
  locale === 'tr' ? siteConfig.social.instagramTr : siteConfig.social.instagramEn;

// Bağlantılar sütunu: bölüm çapaları — başlıklar sözlükten yeniden kullanılır
const sectionLinks = [
  { href: '#ozellikler', label: dict.ozellikler.title },
  { href: '#nasil-calisir', label: dict.nasilCalisir.title },
  { href: '#sss', label: dict.sss.title },
  { href: '#indir', label: dict.indir.title },
  { href: '#iletisim', label: dict.iletisim.title },
];

// Sütun başlıkları Newsreader SemiBold (sahip talebi) — text-h3 zaten 600.
const headingClass = 'font-display text-h3 text-textPrimary';
const linkClass =
  'flex min-h-huge items-center text-body text-textSecondary transition-colors hover:text-textPrimary';
---

<!-- Bölüm 9 / Altbilgi — marka bloğu + 3 bağlantı sütunu, altta hairline
     üstünde şirket/atıf bandı. Şirket paragrafları sütundan banda taşındı
     (4. sütun metin yığınıydı); sorumluluk reddi marka bloğunda GÖRÜNÜR kalır
     (brief §0.1). colCompany anahtarı artık render edilmiyor. -->
<footer id="altbilgi" data-section class="border-t border-border py-huge lg:py-section">
  <div class="mx-auto flex w-full max-w-page flex-col gap-xxl px-lg md:px-xxl">
    <div class="grid gap-xl md:grid-cols-3 lg:grid-cols-[1.6fr_1fr_1fr_1fr] lg:gap-lg">
      <!-- Marka bloğu: temaya göre logo + görünür sorumluluk reddi -->
      <div class="flex flex-col gap-base md:col-span-3 lg:col-span-1 lg:pr-xxl">
        <a href={localePath(locale)} aria-label={dict.header.brand} class="self-start">
          <img
            src={withBase('/logo/yatay-beyaz-ustu.svg')}
            alt=""
            aria-hidden="true"
            width="123"
            height="35"
            loading="lazy"
            class="logo-acik"
          />
          <img
            src={withBase('/logo/yatay-siyah-ustu.svg')}
            alt=""
            aria-hidden="true"
            width="123"
            height="34"
            loading="lazy"
            class="logo-koyu"
          />
        </a>
        <p class="text-caption text-textSecondary">{d.disclaimer}</p>
      </div>

      <nav class="flex flex-col gap-sm" aria-label={d.colLinks}>
        <span class={headingClass}>{d.colLinks}</span>
        <ul class="flex flex-col">
          {
            sectionLinks.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-sm">
        <span class={headingClass}>{d.colSocial}</span>
        <ul class="flex flex-col">
          <li>
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={d.instagramAria}
              class:list={[linkClass, 'gap-sm [&_svg]:h-lg [&_svg]:w-lg [&_svg]:fill-current']}
            >
              <span aria-hidden="true" set:html={instagramIcon} />
              {d.instagram}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={d.tiktokAria}
              class:list={[linkClass, 'gap-sm [&_svg]:h-lg [&_svg]:w-lg [&_svg]:fill-current']}
            >
              <span aria-hidden="true" set:html={tiktokIcon} />
              {d.tiktok}
            </a>
          </li>
          <li>
            <!-- Görünür adresin kendisi erişilebilir ad — ayrı aria gerekmez -->
            <a href={`mailto:${siteConfig.contact.email}`} class={linkClass}>
              {siteConfig.contact.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-sm">
        <span class={headingClass}>{d.colLegal}</span>
        <ul class="flex flex-col">
          <li>
            <a
              href={siteConfig.legal.privacyPolicy}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              {d.privacyPolicy}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.legal.distanceSalesAgreement}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              {d.distanceSales}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Alt bant: şirket kimliği + Google Play atıfı (Q4) -->
    <div
      class="flex flex-col gap-xs border-t border-border pt-lg md:flex-row md:items-baseline md:justify-between md:gap-xl"
    >
      <p class="text-caption text-textMuted">{d.company}</p>
      <p class="text-caption text-textMuted">{d.playTrademark}</p>
    </div>
  </div>
</footer>

<style>
  /* Header'daki iki-img tema takasının aynısı; header mobil boyu (28px)
     ile eşleşir. SVG'ler inline edilmez — sınıf/id çakışması riski var. */
  .logo-acik,
  .logo-koyu {
    height: 28px;
    width: auto;
  }
  .logo-koyu {
    display: none;
  }
  :global(html[data-theme='dark']) .logo-koyu {
    display: block;
  }
  :global(html[data-theme='dark']) .logo-acik {
    display: none;
  }
</style>
