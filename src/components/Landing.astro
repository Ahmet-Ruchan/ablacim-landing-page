---
import Hero from './sections/Hero.astro';
import PalmDivider from './PalmDivider.astro';
import AblaKim from './sections/AblaKim.astro';
import Ozellikler from './sections/Ozellikler.astro';
import NasilCalisir from './sections/NasilCalisir.astro';
import SohbetFarki from './sections/SohbetFarki.astro';
import Gizlilik from './sections/Gizlilik.astro';
import Sss from './sections/Sss.astro';
import Indir from './sections/Indir.astro';
import Sosyal from './sections/Sosyal.astro';
import Iletisim from './sections/Iletisim.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- Bölüm sırası brief §9 — Altbilgi Base layout'ta.
     İndir kapanış CTA'sı olarak yerinde kaldı; Sosyal ve İletişim onun
     ardına, altbilginin hemen üstüne eklendi (dönüşüm → topluluk →
     iletişim). Böylece kapanış CTA'sı seyrelmez. -->
<Hero locale={locale} />
<!-- İmza öğesi tek örnek: hero sonrası bölüm ayracı (Q1; brief §2 çoğaltma yasağı) -->
<PalmDivider />
<AblaKim locale={locale} />
<Ozellikler locale={locale} />
<NasilCalisir locale={locale} />
<SohbetFarki locale={locale} />
<Gizlilik locale={locale} />
<Sss locale={locale} />
<Indir locale={locale} />
<Sosyal locale={locale} />
<Iletisim locale={locale} />
