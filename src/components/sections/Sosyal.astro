---
import { t, type Locale } from '../../i18n';
import { siteConfig } from '../../site.config';
import instagramIcon from '../../../assets/icons/instagram.svg?raw';
import tiktokIcon from '../../../assets/icons/tiktok.svg?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const d = dict.sosyal;

// Dil eşleşmesi (BRIEF-EK S-6) — header/altbilgi ile aynı kural
const instagramUrl =
  locale === 'tr' ? siteConfig.social.instagramTr : siteConfig.social.instagramEn;

/** Kullanıcı adını adresten türetir; siteConfig tek kaynak kalsın diye. */
function handle(url: string): string {
  const last = url.replace(/\/+$/, '').split('/').pop() ?? '';
  return last.startsWith('@') ? last : `@${last}`;
}

const hesaplar = [
  {
    href: instagramUrl,
    icon: instagramIcon,
    name: dict.footer.instagram,
    aria: dict.footer.instagramAria,
    handle: handle(instagramUrl),
    desc: d.instagramDesc,
  },
  {
    href: siteConfig.social.tiktok,
    icon: tiktokIcon,
    name: dict.footer.tiktok,
    aria: dict.footer.tiktokAria,
    handle: handle(siteConfig.social.tiktok),
    desc: d.tiktokDesc,
  },
];
---

<!-- Bölüm 9 / Sosyal — iki hesap kartı yan yana (mobilde alt alta).
     Kart dili Özellikler'den devralınır: bakır hairline çerçeve, hover'da
     çizgi tam güce çıkar. Mistik öğe yok. Kartın tamamı bağlantıdır;
     erişilebilir ad aria-label'dan gelir, ikon dekoratif. -->
<section id="sosyal" data-section class="flex flex-col gap-lg">
  <h2 class="font-display text-h2">{d.title}</h2>
  <p class="text-body text-textSecondary">{d.intro}</p>
  <div data-stagger class="grid gap-md md:grid-cols-2">
    {
      hesaplar.map((hesap) => (
        <a
          href={hesap.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={hesap.aria}
          class="hesap flex items-start gap-base rounded-lg border border-premiumHairline bg-surface p-lg"
        >
          <span
            aria-hidden="true"
            class="hesap-ikon flex h-huge w-huge shrink-0 items-center justify-center rounded-pill border border-premiumHairline bg-premiumSubtle text-premium"
            set:html={hesap.icon}
          />
          <span class="flex flex-col gap-xxs">
            <span class="text-h3 text-textPrimary">{hesap.name}</span>
            <span class="text-caption text-premium">{hesap.handle}</span>
            <span class="text-caption text-textSecondary">{hesap.desc}</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .hesap {
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  .hesap:hover {
    border-color: var(--premium);
    background-color: var(--surfaceAlt);
  }
  /* Genel 1.5px halka bakır çizginin üstünde zayıf kalıyor — offsetli 2px */
  .hesap:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Marka ikonları dolgu tabanlı (simple-icons); currentColor'a bağlanır */
  .hesap-ikon :global(svg) {
    height: var(--spacing-xl);
    width: var(--spacing-xl);
    fill: currentColor;
  }
</style>
