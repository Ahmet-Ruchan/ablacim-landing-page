---
import { t, type Locale } from '../../i18n';
import StoreBadge from '../StoreBadge.astro';
import CtaButton from '../CtaButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const d = dict.indir;
---

<!-- Bölüm 8 / İndir — kapanış CTA. Rozet ve yasal satırlar kart içinde
     (boşlukta yüzmesin). Masaüstünde üstte 128: gap 96 + pt 32. -->
<section id="indir" data-section class="flex flex-col gap-md lg:pt-xxl">
  <h2 class="font-display text-h2">{d.title}</h2>
  <p class="text-body text-textSecondary">{d.body}</p>
  <div class="flex flex-col gap-md rounded-lg border border-premiumHairline bg-surface p-lg">
    <StoreBadge locale={locale} />
    <!-- CTA 3/3 — mağaza rozetlerinin yanında web alternatifi -->
    <CtaButton label={dict.cta.start} />
    <p class="text-caption text-textSecondary">{d.currencyNote}</p>
    <!-- Q3 aktif: otomatik yenileme tek satır caption -->
    <p class="text-caption text-textSecondary">{d.autoRenewNote}</p>
  </div>
</section>
