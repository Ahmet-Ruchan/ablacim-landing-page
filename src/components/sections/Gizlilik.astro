---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).gizlilik;
---

<!-- Bölüm 6 / Gizlilik — mistik öğe yok. İkincil blok: surfaceAlt panel,
     büyük panel yarıçapı xl (brief §5.2). Accent tint bilerek değil —
     bilgi bloğu tıklanabilir gibi durmamalı. -->
<section id="gizlilik" data-section class="flex flex-col gap-md">
  <h2 class="font-display text-h2">{d.title}</h2>
  <div class="flex flex-col gap-md rounded-xl bg-surfaceAlt p-lg">
    <p class="text-body text-textSecondary">{d.intro}</p>
    <ul class="flex flex-col gap-sm">
      {d.items.map((item) => <li class="text-body text-textPrimary">{item}</li>)}
    </ul>
    <p class="text-body text-textSecondary">{d.note}</p>
  </div>
</section>
