---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).ablaKim;
---

<!-- Bölüm 2 / Abla kim — ≥1024px iki sütun: solda bakır etiket + başlık +
     giriş (5 birim), sağda anlatı + ilkeler + "ne yapmaz" paneli (7 birim).
     Neden: tek sütunken gövde 70ch'te kesiliyor, 1200px konteynerin sağ
     yarısı boş kalıyor ve metin sola yapışmış görünüyordu (sahip bildirimi).
     Mistik öğe yok; imza yalnız bakır çizgi (K-2). -->
<section
  id="abla-kim"
  data-section
  class="flex flex-col gap-xl lg:grid lg:grid-cols-12 lg:items-start lg:gap-xxl"
>
  <div class="flex flex-col gap-md lg:col-span-5">
    <span class="text-label uppercase text-premium">{d.eyebrow}</span>
    <h2 class="font-display text-h2">{d.title}</h2>
    <p class="text-bodyLg text-textSecondary">{d.body}</p>
  </div>

  <div class="flex flex-col gap-lg lg:col-span-7">
    {d.paragraphs.map((paragraph) => <p class="text-body text-textSecondary">{paragraph}</p>)}

    <!-- İlkeler — satır düzeni (3 sütun dar kalıyordu): bakır tik + başlık
         solda, açıklama sağda; aralarında hairline ayraç -->
    <ul
      data-stagger
      class="flex flex-col divide-y divide-border rounded-lg border border-premiumHairline bg-surface"
    >
      {
        d.principles.map((ilke) => (
          <li class="flex flex-col gap-xs p-base sm:flex-row sm:items-baseline sm:gap-base">
            <span class="flex shrink-0 items-center gap-sm sm:w-2/5">
              <span aria-hidden="true" class="h-xxs w-md shrink-0 rounded-pill bg-premium" />
              <span class="text-bodyStrong text-textPrimary">{ilke.title}</span>
            </span>
            <span class="text-body text-textSecondary">{ilke.desc}</span>
          </li>
        ))
      }
    </ul>

    <!-- Sınırlar — altbilgideki sorumluluk reddinin bölüm içi karşılığı.
         Nötr panel; tıklanabilir görünmemesi için accent tint yok. -->
    <div class="flex flex-col gap-sm rounded-xl bg-surfaceAlt p-lg">
      <span class="text-label uppercase text-textMuted">{d.notTitle}</span>
      <ul class="flex flex-col gap-xs">
        {
          d.notItems.map((item) => (
            <li class="flex gap-sm text-body text-textSecondary">
              <span aria-hidden="true" class="text-premium">
                –
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
