---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).ablaKim;
---

<!-- Bölüm 2 / Abla kim -->
<section id="abla-kim" data-section class="flex flex-col gap-md">
  <h2 class="font-display text-h2">{d.title}</h2>
  <p class="text-body text-textSecondary">{d.body}</p>
</section>
