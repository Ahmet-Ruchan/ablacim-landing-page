---
import { t, type Locale } from '../i18n';
import { siteConfig, withBase } from '../site.config';

interface Props {
  locale: Locale;
  /** İndir kartında rozetler ortalanır; Hero'daki sola yaslı düzen değişmez. */
  center?: boolean;
}

const { locale, center = false } = Astro.props;
const d = t(locale).store;

// Resmî Google Play rozeti, yerelde barındırılıyor (Q4). Dil eşleşmeli.
const badgeSrc = withBase(
  locale === 'tr' ? '/badges/google-play-tr.png' : '/badges/google-play-en.png',
);

// Resmî App Store rozeti (8 Eki, KR-029 — uygulama yayında; EK S-6 yasağı
// yalnız yayında OLMAYAN uygulama içindi). Apple'ın rozet aracından
// indirildi, yerelde barındırılıyor, dil eşleşmeli. Play PNG'si kendi
// saydam dolgusunu taşıyor (görünen rozet 48px kutunun ~32–37px'i);
// App Store SVG'si dolgusuz geldiği için aynı 48px kutuda xxl (32px)
// yüksekliğe oturtuldu — iki rozet göz hizasında eşit durur.
const appStoreSrc = withBase(
  locale === 'tr' ? '/badges/app-store-tr.svg' : '/badges/app-store-en.svg',
);
---

<div class:list={['flex flex-wrap items-center', center && 'justify-center']}>
  <!-- p-md = 12px: rozet yüksekliğinin (48px) %25'i kadar boşluk (Q4).
       Dış bağlantı — yeni sekmede açılır (talimat). -->
  <a
    href={siteConfig.store.appStoreUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="box-content inline-flex h-huge items-center self-start p-md"
  >
    <img
      src={appStoreSrc}
      alt={d.appStoreAlt}
      width={locale === 'tr' ? 151 : 120}
      height="40"
      class="h-xxl w-auto"
    />
  </a>
  <a
    href={siteConfig.store.googlePlayUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex self-start p-md"
  >
    <img
      src={badgeSrc}
      alt={d.googlePlayAlt}
      width="646"
      height="250"
      class="h-huge w-auto"
    />
  </a>
</div>
