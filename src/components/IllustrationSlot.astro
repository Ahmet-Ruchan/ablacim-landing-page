---
/**
 * İllüstrasyon — kaynak PNG'ler assets/illustrations/ altında saklanır;
 * build sırasında Astro görsel optimizasyonu WebP (kalite 82) üretir,
 * srcset 1x ve 2x adaylarını taşır.
 * Koyu tema kararı: filtre/invert YOK — açık zeminli görsel "kâğıt öğesi"
 * olarak durur; radii-lg köşe + 1px color-border hairline kenarıyla açık
 * temada zeminden ayrılır, koyu temada kenarı belirir. Ek karartma yok.
 * CLS: width/height öznitelikleri + aspect-ratio sınıfı oranı kilitler.
 * ratio: kart görselleri "square" (1:1), hero "portrait" (4:5).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
 * `eager: true` klasördeki her dosyayı import eder ve import edilen varlık
 * KULLANILMASA BİLE build çıktısına kopyalanır. `x-` önekli dosyalar elenmiş
 * adaylar (25 Ağu: x-hero.png, 2.7 MB) — hiçbir sayfa onlara referans
 * vermediği hâlde dist/'e ham PNG olarak giriyorlardı. Negatif desen onları
 * globun dışında bırakır; dosyalar klasörde olduğu gibi kalır.
 */
const images = import.meta.glob<{ default: ImageMetadata }>(
  [
    '../../assets/illustrations/*.{png,webp,jpg}',
    '!../../assets/illustrations/x-*',
  ],
  { eager: true },
);

interface Props {
  name: string;
  alt: string;
  ratio?: 'square' | 'portrait';
  /** Hero: eager + fetchpriority high; kartlar lazy (varsayılan) */
  eager?: boolean;
}

const { name, alt, ratio = 'square', eager = false } = Astro.props;
const match = Object.entries(images).find(([path]) =>
  path.includes(`/${name}.`),
);
if (!match) throw new Error(`İllüstrasyon kaynağı eksik: ${name}`);

// 1x genişlik en büyük gösterim ölçüsünden: kart masaüstünde ~244px,
// mobil tek sütunda tam genişlik; hero sütunu tam doldurur
// (masaüstünde ~460px, mobilde tam genişlik — büyütme talebi).
const oneX = ratio === 'portrait' ? 560 : 400;
const height = ratio === 'portrait' ? oneX * 1.25 : oneX;
const sizes =
  ratio === 'portrait'
    ? '(min-width: 1024px) 460px, calc(100vw - 40px)'
    : '(min-width: 768px) 244px, calc(100vw - 40px)';
---

<Image
  src={match[1].default}
  alt={alt}
  width={oneX}
  height={height}
  widths={[oneX, oneX * 2]}
  sizes={sizes}
  format="webp"
  quality={82}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class:list={[
    ratio === 'portrait' ? 'aspect-4/5' : 'aspect-square',
    'w-full rounded-lg border border-border object-cover',
  ]}
/>
