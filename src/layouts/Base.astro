---
import '@fontsource/newsreader/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, localePath, type Locale } from '../i18n';
import { siteConfig, withBase } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const canonical = new URL(localePath(locale), siteConfig.siteUrl).href;
const trUrl = new URL('/tr/', siteConfig.siteUrl).href;
const enUrl = new URL('/en/', siteConfig.siteUrl).href;
const ogLocale = locale === 'tr' ? 'tr_TR' : 'en_US';
const ogLocaleAlt = locale === 'tr' ? 'en_US' : 'tr_TR';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <!-- Mobil tarayıcı kabuğu sayfa zeminiyle aynı renkte olsun.
         prefers-color-scheme kullanılamaz: tema OS'ten değil site içi
         pilden geliyor. Değer aşağıdaki FOUC scripti ve ThemePill
         tarafından güncellenir. Hex'ler tokens.css --bg değerleridir
         (light --kul-50, dark #150f19); orada değişirse burası da
         değişmeli. -->
    <meta name="theme-color" content="#f7f4f6" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.siteUrl}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta
      property="og:image"
      content={new URL(locale === 'tr' ? '/og-tr.png' : '/og-en.png', siteConfig.siteUrl).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Tema, ilk boyamadan önce kurulur. İki durum: light | dark.
         Öncelik: URL parametresi (QA zorlaması) > kayıtlı tercih > sistem
         temasından türetilen varsayılan. data-theme-pref pil thumb'ını sürer. -->
    <script is:inline>
      (function () {
        var pref = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        try {
          var stored = localStorage.getItem('ablacim-theme');
          if (stored === 'light' || stored === 'dark') pref = stored;
        } catch (e) {
          /* localStorage kapalıysa sistem türevi geçerli */
        }
        var forced = location.search.match(/[?&]theme=(dark|light)\b/);
        if (forced) pref = forced[1];
        document.documentElement.setAttribute('data-theme', pref);
        document.documentElement.setAttribute('data-theme-pref', pref);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', pref === 'dark' ? '#150f19' : '#f7f4f6');
      })();
    </script>
  </head>
  <body class="bg-bg font-sans text-body text-textPrimary">
    <!-- Hareket bütçesi (adım 3/5): bölüm girişleri + ayraç çizimi.
         PRM açıksa veya JS yoksa .motion eklenmez → her şey anında görünür. -->
    <script>
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      if (!reduceMotion) {
        document.documentElement.classList.add('motion');

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target); // bir kez — geri sarmaz
              }
            }
          },
          { threshold: 0.15 },
        );
        document
          .querySelectorAll('[data-section]')
          .forEach((section) => io.observe(section));

        // Klavye odağı animasyona girmemiş bölüme inerse bölümü hemen göster
        document.addEventListener('focusin', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const section = target.closest('[data-section]');
          if (section && !section.classList.contains('is-visible')) {
            section.classList.add('is-visible');
            io.unobserve(section);
          }
        });

        // Avuç çizgisi: görünür olunca soldan sağa çizilir (800ms).
        // PRM'de bu blok hiç çalışmaz — çizgi çizili başlar.
        // Not: non-scaling-stroke dash desenini EKRAN pikselinde uygular,
        // getTotalLength ise viewBox biriminde döner; ölçeklenmezse çizgi
        // kopuk kopuk görünür (sahip bildirimi). Uzunluk ekrana ölçeklenir
        // ve animasyon bitince dash tamamen kaldırılır.
        const divider = document.querySelector('[data-divider]');
        const path = divider?.querySelector('path');
        const dividerSvg = divider?.querySelector('svg');
        if (divider && dividerSvg && path instanceof SVGPathElement) {
          const scale =
            divider.getBoundingClientRect().width /
              dividerSvg.viewBox.baseVal.width || 1;
          const len = Math.ceil(path.getTotalLength() * Math.max(scale, 1));
          path.style.strokeDasharray = String(len);
          path.style.strokeDashoffset = String(len);
          path.addEventListener(
            'transitionend',
            () => {
              path.style.removeProperty('stroke-dasharray');
              path.style.removeProperty('stroke-dashoffset');
              path.style.removeProperty('transition');
            },
            { once: true },
          );
          const dividerIo = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  path.style.transition =
                    'stroke-dashoffset 800ms var(--ease-decelerate)';
                  requestAnimationFrame(() => {
                    path.style.strokeDashoffset = '0';
                  });
                  dividerIo.disconnect();
                }
              }
            },
            { threshold: 0.5 },
          );
          dividerIo.observe(divider);
        }
      }
    </script>

    <!-- Atlama bağlantısı: klavyeyle gelen kullanıcı header'daki sosyal
         ikon + iki pili her sayfada geçmek zorunda kalmasın. Görünmez
         durur, yalnız odaklanınca belirir. -->
    <a href="#icerik" class="atla">{d.header.skipToContent}</a>

    <Header locale={locale} />
    <!-- Konteyner: 1200px ortalı; yatay dolgu mobil 20, ≥768px 32.
         Bölüm ritmi sahip talebiyle bir kademe küçüldü:
         mobil 48, ≥1024px 64; hero ve kapanış 96 (64 + 32 dolgu) -->
    <main
      id="icerik"
      tabindex="-1"
      class="mx-auto flex w-full max-w-page flex-col gap-huge px-lg py-huge md:px-xxl lg:gap-section lg:py-section"
    >
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  /* Atlama hedefi: programatik odak alır ama görünür halka basmaz —
     kullanıcı zaten oraya gitmeyi kendi istedi. */
  main:focus {
    outline: none;
  }
  main {
    scroll-margin-top: var(--header-height);
  }

  /* Yapışkan header'ın üstünde kalması için z-index header'dan (10) büyük */
  .atla {
    position: absolute;
    left: -9999px;
    top: 0;
  }
  .atla:focus {
    position: fixed;
    left: var(--spacing-base);
    top: var(--spacing-base);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    padding-inline: var(--spacing-lg);
    border-radius: var(--radius-pill);
    background-color: var(--accent);
    color: var(--onAccent);
    font-weight: 500;
  }
</style>
